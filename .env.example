# SageCommand Air Power System (Aero) — Environment Configuration Template
# Copy to .env and customize as needed. Do NOT commit secrets or real credentials.

# Application Configuration
AERO_APP_NAME="SageCommand Air Power System — Aero"
AERO_APP_VERSION="0.1.0"
AERO_ENV="development"
AERO_DEBUG=false

# Server Configuration
AERO_API_HOST="0.0.0.0"
AERO_API_PORT=8000
AERO_API_PREFIX="/api/v1"

# Database Configuration (SQLite with WAL mode by default)
AERO_DATABASE_URL="sqlite:///./aero_datacore.sqlite"
AERO_DATABASE_ECHO=false
AERO_DATABASE_WAL_MODE=true
AERO_DATABASE_BUSY_TIMEOUT_MS=5000

# Logging Configuration
AERO_LOG_LEVEL="INFO"
AERO_LOG_FORMAT="json"

# CORS Configuration (JSON array format)
AERO_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
